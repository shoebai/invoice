{
  "name": "aqsa-hotel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aqsa Hotel Invoice System",
  "author": "Aqsa Hotels <support@aqsahotels.com>",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.aqsa.invoice",
    "productName": "Aqsa Invoice",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/.cache",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "electron",
        "to": "electron",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aqsa Invoice",
      "deleteAppDataOnUninstall": false,
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "license": "public/license.txt",
      "installerLanguages": [
        "en_US",
        "ar"
      ],
      "language": "1025",
      "include": "electron/installer.nsh"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.aqsahotels.com/releases/"
      }
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "firebase": "^12.12.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^4.4.0",
    "wait-on": "^7.2.0"
  }
}
